{
  "$source": "https://www.x-kom.pl (captured 2026-10-20 via Playwright, cookie modal accepted)",
  "colors": {
    "brand": {
      "primary": "#222222",
      "accent": "#0082FA",
      "error": null,
      "success": "#007D00"
    },
    "background": {
      "default": "#FFFFFF",
      "light": "#F7F7F7",
      "overlay": "rgba(0, 0, 0, 0.08)"
    },
    "text": {
      "primary": "#1A1A1A",
      "secondary": "#444444",
      "muted": "#6E6E6E",
      "onDark": "#FFFFFF"
    },
    "extra": {
      "promo": "#B50067",
      "successSurface": "#EEF7ED",
      "border": "#DDDDDD"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "\"Instrument Sans\", sans-serif"
    },
    "fontWeights": {
      "regular": 400,
      "medium": null,
      "semibold": 600,
      "bold": 700
    },
    "fontSize": {
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "26px",
      "display": "28px"
    },
    "lineHeight": {
      "tight": "1.2",
      "base": "1.4",
      "relaxed": "1.6"
    }
  },
  "spacing": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "7": "28px", "8": "32px"
  },
  "borderRadius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "512px",
    "circle": "50%"
  },
  "components": {
    "button": {
      "primary": {
        "backgroundColor": "#222222",
        "color": "#FFFFFF",
        "padding": "12px 24px",
        "borderRadius": "8px",
        "fontSize": "16px"
      }
    },
    "header": {
      "backgroundColor": "#FFFFFF",
      "padding": "0px",
      "fontSize": "14px",
      "height": "72px"
    },
    "nav": {
      "color": "#1A1A1A",
      "fontSize": "14px",
      "fontWeight": "400"
    },
    "tag": {
      "backgroundColor": "#EEF7ED",
      "color": "#007D00",
      "padding": "1.5px 6px 2.5px",
      "borderRadius": "4px",
      "fontSize": "13px"
    }
  }
}
